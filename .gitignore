# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local AI keys for --dart-define-from-file. Keep examples in git, never real keys.
env/*.local.json
env/*.local.env

# Local backups created by the browser food-review tool.
tooling/.food_review_backups/

# Local Firebase project binding. Keep examples in git, but each developer
# should use their own Firebase project files.
.firebaserc
android/app/google-services.json

# Local key backups and Claude Code session config. Never push these.
_keys_backup/
.claude/

# Root scratch output (emulator screenshots, video verification frames).
/out/

# Presentation (Remotion promo): keep source/code/docs/small assets in git, but
# not the heavy raw media — screen recordings + voiceovers stay on disk only.
presentation/**/*.mp4
presentation/**/*.mp3
presentation/**/*.wav
